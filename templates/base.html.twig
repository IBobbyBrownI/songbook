<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {# no-FOUC: выставить выбранную тему до первого рендера #}
    <script>(function(){try{var t=localStorage.getItem('songbook-theme');if(t){document.documentElement.dataset.theme=t;}}catch(e){}})();</script>
    <title>{% block title %}Песенник{% endblock %}</title>
    <meta name="theme-color" content="#FBFAF7" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#15171E" media="(prefers-color-scheme: dark)">
    {# favicon — восьмая нота (инлайн-SVG, без файла) #}
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Cg fill='%231E6F66'%3E%3Crect x='17' y='5' width='2.4' height='17'/%3E%3Cpath d='M17 5 L26 7 L26 11 L17 9 Z'/%3E%3Cellipse cx='13' cy='22' rx='5' ry='4'/%3E%3C/g%3E%3C/svg%3E">
    {# критичные шрифты — preload (текст + титулы, above-the-fold) #}
    <link rel="preload" href="{{ asset('fonts/plexsans-latin-400.woff2') }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ asset('fonts/plexsans-cyrillic-400.woff2') }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ asset('fonts/lora-latin-700.woff2') }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ asset('fonts/lora-cyrillic-700.woff2') }}" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    {# Lit резолвится через import map → вендоренный ESM-бандл (без сборки/CDN) #}
    <script type="importmap">{ "imports": { "lit": "{{ asset('js/vendor/lit-all.min.js') }}" } }</script>
    <script type="module" src="{{ asset('js/app.js') }}"></script>
    {% block head %}{% endblock %}
</head>
<body>
{# active — id текущего раздела для подсветки навигации; читается, но не выводится #}
{% set active = block('active') is defined ? block('active')|trim : '' %}
<a class="skip-link" href="#content">Перейти к содержимому</a>

<header class="site-header">
    <div class="container site-header__inner">
        <a href="/" class="brand">
            <svg class="brand__mark" width="20" height="20" viewBox="0 0 32 32" aria-hidden="true" fill="currentColor">
                <rect x="17" y="5" width="2.4" height="17"/>
                <path d="M17 5 L26 7 L26 11 L17 9 Z"/>
                <ellipse cx="13" cy="22" rx="5" ry="4"/>
            </svg>
            <span>Песенник</span>
        </a>
        <nav class="site-nav" aria-label="Основная навигация">
            <a href="/" {% if active == 'songs' %}aria-current="page"{% endif %}>Песни</a>
            <a href="/artists" {% if active == 'artists' %}aria-current="page"{% endif %}>Артисты</a>
        </nav>
        <div class="site-header__spacer"></div>
        <theme-toggle></theme-toggle>
        <a href="/songs/new" class="btn btn--primary btn--sm">+ Песня</a>
    </div>
</header>

<main id="content" class="site-content">
    <div class="container">
        {% block content %}{% endblock %}
    </div>
</main>

<footer class="site-footer">
    <div class="container">Песенник &copy; 2026</div>
</footer>

{% block scripts %}{% endblock %}
</body>
</html>
