{% extends 'base.html.twig' %}

{% block title %}{{ artist.name }} — Песенник{% endblock %}

{% block content %}
    <h1>{{ artist.name }}</h1>

    {% if artist.bio %}
        <p>{{ artist.bio|nl2br }}</p>
    {% endif %}

    <h2>Песни</h2>

    {% if songs is empty %}
        <p>Нет песен</p>
    {% else %}
        <ul>
            {% for song in songs %}
                <li>
                    <a href="/songs/{{ song.slug }}">{{ song.title }}</a>
                    <span>({{ song.role }})</span>
                </li>
            {% endfor %}
        </ul>
    {% endif %}

    <a href="/artists/{{ artist.slug }}/edit">Редактировать</a>

    <form method="POST" action="/artists/{{ artist.slug }}/delete" onsubmit="return confirm('Удалить артиста?');">
        <button type="submit">Удалить</button>
    </form>
{% endblock %}