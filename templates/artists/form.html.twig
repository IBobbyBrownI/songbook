{% extends 'base.html.twig' %}

{% block title %}
    {% if mode == 'edit' %}Редактировать артиста{% else %}Новый артист{% endif %} — Песенник
{% endblock %}

{% block content %}
    <h1>{% if mode == 'edit' %}Редактировать артиста{% else %}Новый артист{% endif %}</h1>

    <form method="POST"
          action="{% if mode == 'edit' %}/artists/{{ artist.slug }}/update{% else %}/artists{% endif %}">

        <div>
            <label for="name">Имя</label>
            <input type="text" id="name" name="name" value="{{ artist.name }}" maxlength="255" required>
            {% if errors.name %}
                <span class="form-error">{{ errors.name }}</span>
            {% endif %}
        </div>

        <div>
            <label for="bio">Биография</label>
            <textarea id="bio" name="bio" rows="5">{{ artist.bio }}</textarea>
            {% if errors.bio %}
                <span class="form-error">{{ errors.bio }}</span>
            {% endif %}
        </div>

        <button type="submit">
            {% if mode == 'edit' %}Сохранить{% else %}Создать{% endif %}
        </button>
    </form>
{% endblock %}