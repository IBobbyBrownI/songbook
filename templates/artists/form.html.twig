{% extends 'base.html.twig' %}
{% import 'components/_form_field.html.twig' as field %}

{% block title %}
    {% if mode == 'edit' %}Редактировать артиста{% else %}Новый артист{% endif %} — Песенник
{% endblock %}

{% block content %}
    <h1>{% if mode == 'edit' %}Редактировать артиста{% else %}Новый артист{% endif %}</h1>

    <form class="form" method="POST"
          action="{% if mode == 'edit' %}/artists/{{ artist.slug }}/update{% else %}/artists{% endif %}">

        {{ field.text('name', 'Имя', artist.name, errors.name, 'maxlength="255" required') }}
        {{ field.textarea('bio', 'Биография', artist.bio, errors.bio, 'rows="5"') }}

        <div class="cluster">
            <button class="btn btn--primary" type="submit">{% if mode == 'edit' %}Сохранить{% else %}Создать{% endif %}</button>
            <a class="btn btn--ghost" href="/artists">Отмена</a>
        </div>
    </form>
{% endblock %}
