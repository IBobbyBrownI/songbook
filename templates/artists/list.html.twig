{% extends 'base.html.twig' %}
{% import 'components/_pluralize.html.twig' as plural %}

{% block title %}Артисты — Песенник{% endblock %}

{% block content %}
    <div class="page-header">
        <h1>Артисты</h1>
        <a class="btn btn--primary" href="/artists/new">+ Добавить артиста</a>
    </div>

    {% if artists is empty %}
        <div class="empty-state">Нет артистов</div>
    {% else %}
        <div class="artist-list">
            {% for artist in artists %}
                <div class="artist-list__row">
                    <a href="/artists/{{ artist.slug }}">{{ artist.name }}</a>
                    <span class="chip">{{ plural.songs(artist.songs_count) }}</span>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
