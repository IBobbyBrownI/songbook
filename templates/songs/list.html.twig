{% extends 'base.html.twig' %}
{% import 'components/_pluralize.html.twig' as plural %}
{% block active %}songs{% endblock %}

{% block title %}Песни — Песенник{% endblock %}

{% block content %}
    <section class="title-page">
        <p class="eyebrow title-page__eyebrow">Песенник</p>
        <h1 class="title-page__title">Песни</h1>
        <p class="title-page__lead">Тексты с аккордами над строкой — для репетиции и сцены.</p>
        {% if songs is not empty %}
            <div class="title-page__meta">
                <span class="chip">{{ plural.songs(songs|length) }}</span>
            </div>
        {% endif %}
    </section>

    {% include 'components/_filter_bar.html.twig' with { filters: filters, available_keys: available_keys } only %}

    {% if filters.q or filters.key or filters.license %}
        <p class="active-filters">
            Применено:
            {% if filters.q %}поиск «{{ filters.q }}»{% endif %}
            {% if filters.key %}· тональность {{ filters.key }}{% endif %}
            {% if filters.license %}· лицензия {{ filters.license }}{% endif %}
        </p>
    {% endif %}

    {% if songs is empty %}
        <div class="empty-state">
            <p>Ничего не найдено.</p>
            <div class="empty-state__actions">
                <a class="btn btn--primary" href="/songs/new">+ Добавить песню</a>
            </div>
        </div>
    {% else %}
        <div class="song-list">
            {% for song in songs %}
                {% include 'components/_song_card.html.twig' with { song: song } only %}
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
