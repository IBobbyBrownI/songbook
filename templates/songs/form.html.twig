{% extends 'base.html.twig' %}
{% import 'components/_form_field.html.twig' as field %}
{% import 'components/_licenses.html.twig' as licenses %}
{% block active %}songs{% endblock %}

{% block title %}
    {% if mode == 'edit' %}Редактировать — {{ song.title }}{% else %}Новая песня{% endif %} — Песенник
{% endblock %}

{% block content %}
    <h1>{% if mode == 'edit' %}Редактировать: {{ song.title }}{% else %}Новая песня{% endif %}</h1>

    <form class="form" method="POST"
          action="{% if mode == 'edit' %}/songs/{{ song.slug }}/update{% else %}/songs{% endif %}">

        {{ field.text('title', 'Название', song.title, errors.title, 'maxlength="255" required') }}

        {# Текст ChordPro — моноширинный редактор с подсказкой #}
        <div class="form-field {% if errors.lyrics_chordpro %}form-field--invalid{% endif %}">
            <label for="lyrics_chordpro">Текст песни (ChordPro)</label>
            <textarea id="lyrics_chordpro" name="lyrics_chordpro" class="textarea--mono" rows="14" required
                      placeholder="{title: Название}&#10;{key: C}&#10;{c: Куплет 1}&#10;[C]Текст [G]песни">{{ song.lyrics_chordpro }}</textarea>
            <p class="form-hint">Аккорды в квадратных скобках <code>[C]</code>, директивы <code>{title:}</code> <code>{key:}</code> <code>{c: …}</code> на отдельной строке.</p>
            {% if errors.lyrics_chordpro %}<span class="form-error">{{ errors.lyrics_chordpro }}</span>{% endif %}
        </div>

        <div class="form-field {% if errors.key_original %}form-field--invalid{% endif %}">
            <label for="key_original">Тональность</label>
            <fancy-select>
                <select id="key_original" name="key_original" aria-label="Тональность">
                    {% for key in keys %}
                        <option value="{{ key }}" {% if song.key_original == key %}selected{% endif %}>{{ key }}</option>
                    {% endfor %}
                </select>
            </fancy-select>
            {% if errors.key_original %}<span class="form-error">{{ errors.key_original }}</span>{% endif %}
        </div>

        <div class="form-field {% if errors.license %}form-field--invalid{% endif %}">
            <label for="license">Лицензия</label>
            <fancy-select>
                <select id="license" name="license" aria-label="Лицензия">
                    {{ licenses.options(song.license) }}
                </select>
            </fancy-select>
            {% if errors.license %}<span class="form-error">{{ errors.license }}</span>{% endif %}
        </div>

        <fieldset class="artist-picker-field">
            <legend>Артисты</legend>
            {% if all_artists is empty %}
                <p class="text-muted">Нет доступных артистов.</p>
            {% else %}
                <div class="artist-picker">
                    {% for artist in all_artists %}
                        <div class="artist-picker__row">
                            <label class="artist-picker__check">
                                <input type="checkbox" name="artists[{{ artist.id }}][id]" value="{{ artist.id }}"
                                       {% if artist.id in selected_artists|keys %}checked{% endif %}>
                                <span>{{ artist.name }}</span>
                            </label>
                            {% set sel_role = selected_artists[artist.id].role|default('performer') %}
                            <fancy-select compact class="artist-picker__role">
                                <select name="artists[{{ artist.id }}][role]" aria-label="Роль артиста {{ artist.name }}">
                                    <option value="author" {% if sel_role == 'author' %}selected{% endif %}>Автор</option>
                                    <option value="composer" {% if sel_role == 'composer' %}selected{% endif %}>Композитор</option>
                                    <option value="translator" {% if sel_role == 'translator' %}selected{% endif %}>Переводчик</option>
                                    <option value="performer" {% if sel_role == 'performer' %}selected{% endif %}>Исполнитель</option>
                                </select>
                            </fancy-select>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
            {% if errors.artists %}<span class="form-error">{{ errors.artists }}</span>{% endif %}
        </fieldset>

        <div class="cluster">
            <button class="btn btn--primary" type="submit">{% if mode == 'edit' %}Сохранить{% else %}Создать{% endif %}</button>
            <a class="btn btn--ghost" href="{% if mode == 'edit' %}/songs/{{ song.slug }}{% else %}/{% endif %}">Отмена</a>
        </div>
    </form>
{% endblock %}
