{% extends 'base.html.twig' %}

{% block title %}{{ song.title }} — Песенник{% endblock %}

{% block content %}
    <article class="song-page">
        <header class="song-header">
            <div class="song-header__main">
                <h1 class="song-header__title">{{ song.title }}</h1>
                {% include 'components/_credits.html.twig' with { artists: artists } only %}
                {% include 'components/_badge.html.twig' with { license: song.license } only %}
            </div>
            <div class="song-header__actions">
                <a class="btn btn--ghost btn--sm" href="/songs/{{ song.slug }}/edit">Изменить</a>
                <form method="POST" action="/songs/{{ song.slug }}/delete" onsubmit="return confirm('Удалить песню?');">
                    <button class="btn btn--ghost btn--sm btn--danger" type="submit">Удалить</button>
                </form>
            </div>
        </header>

        {% include 'components/_chord_sheet.html.twig' with { song: song, chordpro_html: chordpro_html } only %}
    </article>
{% endblock %}
