{
    "require": {
        "symfony/http-foundation": "^8.0",
        "symfony/dotenv": "^8.0",
        "ext-pdo": "*",
        "cocur/slugify": "^4.7",
        "symfony/routing": "^8.1",
        "twig/twig": "^3.27"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "scripts": {
        "cs-check": "php-cs-fixer fix --dry-run --diff --allow-risky=yes",
        "cs-fix": "php-cs-fixer fix --allow-risky=yes"
    }
}
